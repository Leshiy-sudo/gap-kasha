# Токен Яндекс.Диска (см. README, шаг "Получение токена")
YANDEX_TOKEN=

# Папка на Яндекс.Диске с книгами (путь как в веб-интерфейсе, без "disk:")
YANDEX_BOOKS_PATH=/Книги

# Ключ для подписи cookie сессии — сгенерируй один раз командой:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Хэш и соль пароля для входа — получить командой:
# python scripts/hash_password.py "мой-пароль"
PASSWORD_HASH=
PASSWORD_SALT=

# Сколько символов текста помещать на одну "страницу" читалки
CHARS_PER_PAGE=1600

# true на проде за HTTPS, false только для локальной разработки по http://127.0.0.1
COOKIE_SECURE=true

# Telegram-мост: создайте собственного бота через @BotFather и разрешите только
# свои числовые Telegram user ID, перечисленные через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MAX_FILE_SIZE_MB=20
TELEGRAM_POLL_TIMEOUT_SECONDS=45
KINDLE_READER_PUBLIC_URL=https://kindlereader.duckdns.org/
